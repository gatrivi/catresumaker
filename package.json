{
  "name": "catresumaker",
  "private": true,
  "version": "1.4.3",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "lint": "tsc --noEmit",
    "start": "node dist/server.cjs",
    "job": "tsx job-cannon/cli.ts",
    "job:new": "tsx job-cannon/cli.ts new",
    "job:seed": "tsx job-cannon/cli.ts seed",
    "job:discover": "tsx job-cannon/cli.ts discover",
    "job:score": "tsx job-cannon/cli.ts score",
    "job:pack": "tsx job-cannon/cli.ts pack",
    "job:cannon": "tsx job-cannon/cli.ts cannon",
    "job:list": "tsx job-cannon/cli.ts list",
    "cv:pdf": "tsx job-cannon/cli.ts cv:pdf",
    "job:pdf": "tsx job-cannon/cli.ts job:pdf",
    "obscura:install": "powershell -ExecutionPolicy Bypass -File scripts/install-obscura.ps1"
  },
  "dependencies": {
    "@google/genai": "*",
    "@tailwindcss/vite": "^4.3.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.1",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.19",
    "dotenv": "^16.4.5",
    "esbuild": "^0.24.0",
    "express": "^4.21.1",
    "lucide-react": "^0.468.0",
    "pdfkit": "^0.19.1",
    "postcss": "^8.4.38",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.3",
    "vite": "^6.0.3"
  }
}
