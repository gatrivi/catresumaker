# FreeLLMAPI (preferred). Set this to enable the AI endpoints.
FREELLMAPI_API_KEY=
# Base URL for FreeLLMAPI OpenAI-compatible API (includes `/v1`).
FREELLMAPI_BASE_URL=http://localhost:3001/v1
# Model routed through FreeLLMAPI. Use `auto` unless you want to pin a model.
FREELLMAPI_MODEL=auto

# Optional fallback: Gemini direct access.
GEMINI_API_KEY=

# Optional: set the port the Express server listens on.
# PORT=3000

