# NVIDIA NIM (preferred for Job OS AI tailoring). Free tier at integrate.api.nvidia.com
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=z-ai/glm-5.2

# FreeLLMAPI (OpenAI-compatible fallback)
FREELLMAPI_API_KEY=
FREELLMAPI_BASE_URL=http://localhost:3001/v1
FREELLMAPI_MODEL=auto

# Gemini direct (fallback)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Optional: set the port the Express server listens on.
# PORT=3000

# Required in production when sharing the app with others
JWT_SECRET=change-this-to-a-long-random-string

# Optional: persistent user data on Railway (mount volume at /data)
# DATA_ROOT=/data

# Optional: Obscura headless browser for allowlisted ATS job pages (Lever, Greenhouse, etc.)
# Install: https://github.com/h4ckf0r0day/obscura — never use on LinkedIn/Indeed
OBSCURA_BIN=obscura
OBSCURA_STEALTH=1
OBSCURA_DUMP=markdown
OBSCURA_MIN_INTERVAL_MS=4000
